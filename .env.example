# Copy to .env for reference. The app reads real environment variables (it does not load .env itself),
# e.g.  export $(grep -v '^#' .env | xargs) && npm start
PORT=3000
NODE_ENV=development

# PostgreSQL (production). Leave unset locally to use the JSON file database (data/db.json).
# DATABASE_URL=postgres://user:password@localhost:5432/eod
# DATABASE_SSL=false            # set to true when connecting to a database that requires SSL from outside Render

# REQUIRED in production: a long random string, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# First administrator. In production ADMIN_PASSWORD is required when the database has no admin yet.
ADMIN_NAME=Admin
# ADMIN_PASSWORD=
